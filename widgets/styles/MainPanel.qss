QTabWidget::pane {
    border: none;
}

QTabBar::tab {
    padding: 8px 12px;
    border: none;
    border-top: 2px solid transparent;
    text-align: center;
    color: #999;
}

QTabBar::tab:selected {
    color: white;
    background-color: rgba(0,120,212,15);
    border-top: 2px solid rgb(0,120,212);
}

QTabBar::tab:hover {
    color: white;
}


QSpinBox, QDoubleSpinBox, QLineEdit, QComboBox {
    border: 1px solid #444;
    border-radius: 4px;
    background: #222;
    color: #ddd;
    padding: 3px;
}

QTableWidget {
    gridline-color: #333;
    background-color: #222;
    border-radius: 0px;
}


QTableWidget QSpinBox,
QTableWidget QDoubleSpinBox,
QTableWidget QLineEdit,
QTableWidget QComboBox {
    border: 1px solid transparent;
    border-radius: 0px;
    padding: 0px;
}

QTableWidget QSpinBox:disabled,
QTableWidget QDoubleSpinBox:disabled,
QTableWidget QLineEdit:disabled,
QTableWidget QComboBox:disabled {
    background-color: rgba(212,38,42,15);
}

QTableWidget::horizontalHeader {
    border-top: 1px solid #333;
    border-left: 1px solid #333;
    border-right: 1px solid #333;
    border-bottom: 2px solid #333;
    background-color: transparent;
}
QTableWidget::item {
    border-radius: 0px;
}


QTableWidget::item:selected {
    background-color: rgba(0,120,212,25);
}

QTableWidget::item:hover {
    background-color: rgba(0,120,212,15);
}


QSpinBox, QDoubleSpinBox {
    padding-right: 30px;
}




QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover, QComboBox:hover {
    background: rgba(255,255,255,10);
}
QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus, QComboBox:focus {
    background: rgba(255,255,255,10);
    border: 1px solid rgb(0,120,212);
}


QComboBox::drop-down {
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(:/assets/icons/arrow_down.svg);
    width: 15px;
    height: 15px;
    background: transparent;
    border: none;
}


/* Up and Down buttons in one row */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 15px;
    height: 16px;
    border: none;
    background: transparent;
    subcontrol-origin: border;
    subcontrol-position: right;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #333;
    border: 1px solid #555; /* Creates a separate hover state */
}

/* Fix arrow icons */
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/assets/icons/arrow_up.svg);
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/assets/icons/arrow_down.svg);
}

